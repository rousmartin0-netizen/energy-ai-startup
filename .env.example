# Telegram bot configuration
# Create a bot via @BotFather on Telegram: https://t.me/botfather
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# Market data configuration
# Bidding zone for energy-charts.info API (default: CZ)
# Valid zones: DE-LU, AT, CZ, PL, FR, DK-1, DK-2, SE-1..4, NO-1..5, FI
BIDDING_ZONE=CZ

# Weather forecast location (latitude,longitude)
WEATHER_LAT=50.07
WEATHER_LON=14.43

# News language and country
NEWS_LANG=cs
NEWS_COUNTRY=CZ

# Data file path (relative to project root)
DATA_FILE=market_history.csv

# Max data points to keep in history
MAX_HISTORY_POINTS=50
